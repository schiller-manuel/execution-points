{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "contentMappers": [
    {
      "package": ".",
      "extensions": [".ep"]
    }
  ],
  "include": ["examples/**/*.ts", "src/runtime.d.ts", "points.ep"]
}
