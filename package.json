{
  "name": "execution-points-prototype",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Experimental AST-selected expression replacement with local capture and virtual TypeScript checking",
  "engines": { "node": ">=24" },
  "exports": {
    ".": { "types": "./src/runtime.d.ts", "default": "./src/runtime.mjs" },
    "./runtime": "./src/runtime.mjs",
    "./vite": "./src/plugin.mjs"
  },
  "typescript": {
    "contentMapper": {
      "exec": ["node", "./src/content-mapper.mjs"],
      "dynamicConfig": true
    }
  },
  "scripts": {
    "check": "tsc --noEmit --runExternalCode",
    "test": "vitest run",
    "verify": "node checks/verify.mjs"
  },
  "dependencies": {
    "esquery": "^1.7.0",
    "magic-string": "1.4.5",
    "typescript": "7.1.0-dev.20261121.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
