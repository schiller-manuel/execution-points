{
  "name": "execution-points-prototype",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Experimental AST-selected expression replacement with local capture and virtual TypeScript checking",
  "bin": {
    "execution-points": "./src/cli.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/runtime.d.mts",
      "default": "./dist/runtime.mjs"
    },
    "./points.schema.json": "./points.schema.json",
    "./runtime": {
      "types": "./dist/runtime.d.mts",
      "default": "./dist/runtime.mjs"
    },
    "./vite": "./src/plugin.mjs",
    "./vitest": "./dist/vitest.mjs"
  },
  "files": [
    "dist",
    "src/plugin.mjs",
    "src/discovery.mjs",
    "src/contracts.mjs",
    "src/content-mapper.mjs",
    "src/cli.mjs",
    "points.schema.json"
  ],
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "./src/content-mapper.mjs"
      ],
      "dynamicConfig": true
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit --runExternalCode",
    "test": "tsdown && vitest run",
    "test:oracles": "tsdown && vitest run tests/",
    "verify": "node checks/verify.mjs"
  },
  "dependencies": {
    "magic-string": "1.4.5",
    "typescript": "7.1.0-dev.20261121.1"
  },
  "peerDependencies": {
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-oracles": "https://pkg.pr.new/TanStack/oracles/@tanstack/eslint-plugin-oracles@6d05f05",
    "@tanstack/oracles": "https://pkg.pr.new/TanStack/oracles/@tanstack/oracles@6d05f05",
    "@types/node": "^24.0.0",
    "fast-check": "^4.10.3",
    "tsdown": "^0.23.7",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
